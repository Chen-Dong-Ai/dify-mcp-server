# ===== Dify 账号（仅保存在本机/服务器，切勿提交到代码仓库）=====
# Dify Cloud 地址就用 https://udify.app ；自建版填你的域名，如 http://127.0.0.1:8080
DIFY_BASE_URL=https://udify.app
DIFY_EMAIL=你的Dify登录邮箱
DIFY_PASSWORD=你的Dify登录密码

# ===== 传输模式 =====
# 本地调试：stdio   ；部署给豆包工作台：http
MCP_TRANSPORT=stdio

# ===== HTTP 模式参数 =====
HTTP_HOST=0.0.0.0
HTTP_PORT=9000
# 鉴权 Token：自己起一个长随机字符串，豆包连接器的 Header 里要填同一个值
MCP_HTTP_TOKEN=change-me-to-a-long-random-string
